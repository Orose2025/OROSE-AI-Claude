{%- comment -%} ÉCHEC O CUBE — Section 4 : L'EXPÉRIENCE / THE EXPERIENCE {%- endcomment -%}
<section class="eoc-experience" id="eoc-experience">
  <div class="eoc-experience__bg">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2400 }}"
           srcset="{{ section.settings.image | image_url: width: 1000 }} 1000w,
                   {{ section.settings.image | image_url: width: 2400 }} 2400w"
           sizes="100vw"
           alt="{{ section.settings.image.alt | escape | default: 'ÉCHEC O CUBE — l\'expérience' }}"
           width="2400" height="1600" loading="lazy">
    {%- else -%}
      <div style="width:100%;height:100%;background:var(--eoc-bg-secondary)"></div>
    {%- endif -%}
  </div>
  <div class="eoc-experience__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>
  <div class="eoc-grain"></div>

  <div class="eoc-experience__content eoc-reveal">
    <h2 class="eoc-experience__title">{{ section.settings.headline }}</h2>
    <div class="eoc-experience__body">{{ section.settings.body_fr }}</div>
    <div class="eoc-experience__body-en">{{ section.settings.body_en }}</div>
    {%- if section.settings.cta_label != blank -%}
      <p style="margin-top:2.25rem">
        <a href="{{ section.settings.cta_link }}" class="eoc-btn">{{ section.settings.cta_label }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "EOC — Expérience / Experience",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image de fond (PARTI2JOUEURS.png)" },
    { "type": "range", "id": "overlay_opacity", "label": "Opacité du voile / Overlay opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 40 },
    { "type": "text", "id": "headline", "label": "Titre / Headline", "default": "Une partie. Une tension. Un seul coup décide tout." },
    { "type": "richtext", "id": "body_fr", "label": "Texte FR", "default": "<p>ÉCHEC O CUBE est un jeu de stratégie abstraite né au Québec en 1999. La règle est intégrée dans la matière : si le pion entre dans la rainure, le coup est légal. Fermez un carré, criez ÉCHEC O CUBE, et empochez les points.</p>" },
    { "type": "richtext", "id": "body_en", "label": "Texte EN", "default": "<p>ÉCHEC O CUBE is an abstract strategy game born in Quebec in 1999. The rule lives in the material: if the piece enters the groove, the move is legal. Close a square, shout ÉCHEC O CUBE, and pocket the points.</p>" },
    { "type": "text", "id": "cta_label", "label": "Bouton / Button", "default": "DÉCOUVRIR LES RÈGLES / DISCOVER THE RULES" },
    { "type": "url", "id": "cta_link", "label": "Lien / Link" }
  ],
  "presets": [{ "name": "EOC — Expérience / Experience" }]
}
{% endschema %}
