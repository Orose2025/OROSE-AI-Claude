# Copier ce fichier en `.env` puis y coller les vraies valeurs.
# `.env` est ignoré par git — il ne doit JAMAIS être commité.

# --- Stripe ---
# Clé secrète (serveur uniquement, ne jamais l'exposer côté navigateur)
# Test : sk_test_...  |  Production : sk_live_...
STRIPE_SECRET_KEY=

# Clé publique (peut être exposée côté client)
# Test : pk_test_...  |  Production : pk_live_...
STRIPE_PUBLISHABLE_KEY=

# Secret de signature des webhooks (Stripe Dashboard → Developers → Webhooks)
# whsec_...
STRIPE_WEBHOOK_SECRET=
