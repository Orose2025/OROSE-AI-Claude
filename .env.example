# URL de la passerelle serveur (Cloud Function chatCompletion).
# Absente : l'application fonctionne quand même, avec les seules sources sans clé.
VITE_AI_GATEWAY_URL=

# Clés des sources IA — UNIQUEMENT côté serveur (firebase functions:secrets:set).
# Ne jamais les préfixer VITE_ : elles finiraient publiées dans le bundle.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
HUGGINGFACE_API_KEY=
ALLOWED_ORIGIN=
