{% comment %} ÉCHEC O CUBE — Section Les trois pions — 100% éditable {% endcomment %}

<style>
  #shopify-section-{{ section.id }} .eoc-pions__image-wrapper { width: 100%; text-align: center; }
  #shopify-section-{{ section.id }} .eoc-pions__image { max-width: 100%; height: auto; display: block; margin: 0 auto; border-radius: 8px; }
</style>

<section class="eoc-section eoc-pions">
  <div class="eoc-conteneur">
    <h2>{{ section.settings.titre }}</h2>
    {% if section.settings.intro != blank %}
      <div class="eoc-lead" style="text-align:center;max-width:760px;margin:0 auto 2rem">{{ section.settings.intro }}</div>
    {% endif %}
    <div class="eoc-pions__image-wrapper">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 1400 }}"
          alt="{{ section.settings.image.alt | escape | default: 'Les trois pions ÉCHEC O CUBE' }}"
          class="eoc-pions__image"
          loading="lazy"
          width="1400"
        >
      {% else %}
        <img
          src="https://cdn.shopify.com/s/files/1/0720/4562/5432/files/anatomie-des-pieces-pions.jpg?v=1780898690"
          alt="Anatomie des pièces - Les trois pions"
          class="eoc-pions__image"
          loading="lazy"
          width="1400"
        >
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "EOC — Les trois pions",
  "settings": [
    { "type": "text", "id": "titre", "label": "Titre", "default": "Les trois pions" },
    { "type": "richtext", "id": "intro", "label": "Texte d'introduction (optionnel)" },
    { "type": "image_picker", "id": "image", "label": "Image des trois pions" }
  ],
  "presets": [ { "name": "EOC — Les trois pions" } ]
}
{% endschema %}
